#include <winver.h>
#include "universal_resource.h"
#include "version_resource.h"

#pragma code_page(65001)

#if defined(UNIVERSAL_SERVER)
#define SETUP_PRODUCT "USBRelay Windows 7 x86/x64 Server Setup"
#define SETUP_EXE_NAME "USBRelay-Server-Setup-Universal.exe"
#define SETUP_PAYLOAD_X86 "installer-x86.exe"
#define SETUP_PAYLOAD_X64 "installer-x64.exe"
#elif defined(UNIVERSAL_STANDARD_SERVER)
#define SETUP_PRODUCT "打印机内网共享服务端混合安装包"
#define SETUP_EXE_NAME "USBRelay-Standard-Server-Setup-Universal.exe"
#define SETUP_PAYLOAD_X86 "installer-x86.exe"
#define SETUP_PAYLOAD_X64 "installer-x64.exe"
#elif defined(UNIVERSAL_PORT_TOOL)
#define SETUP_PRODUCT "打印机内网共享配置工具端混合安装包"
#define SETUP_EXE_NAME "USBRelay-Standard-Port-Tool-Setup-Universal.exe"
#define SETUP_PAYLOAD_X86 "installer-x86.exe"
#define SETUP_PAYLOAD_X64 "installer-x64.exe"
#elif defined(UNIVERSAL_CLIENT)
#define SETUP_PRODUCT "USBRelay Windows 7 x86/x64 Client Setup"
#define SETUP_EXE_NAME "USBRelay-Client-Setup-Universal.exe"
#define SETUP_PAYLOAD_X86 "installer-x86.exe"
#define SETUP_PAYLOAD_X64 "installer-x64.exe"
#else
#error Define UNIVERSAL_SERVER, UNIVERSAL_STANDARD_SERVER, UNIVERSAL_PORT_TOOL, or UNIVERSAL_CLIENT when compiling universal.rc.
#endif

IDR_SETUP_X86 RCDATA SETUP_PAYLOAD_X86
IDR_SETUP_X64 RCDATA SETUP_PAYLOAD_X64
IDI_APP_ICON ICON "app.ico"
1 24 "setup.manifest"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION PRODUCT_VERSION_COMMA
 PRODUCTVERSION PRODUCT_VERSION_COMMA
 FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
 FILEFLAGS 0x1L
#else
 FILEFLAGS 0x0L
#endif
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "Open Source Project"
            VALUE "FileDescription", SETUP_PRODUCT
            VALUE "FileVersion", PRODUCT_VERSION_STRING
            VALUE "InternalName", SETUP_EXE_NAME
            VALUE "OriginalFilename", SETUP_EXE_NAME
            VALUE "ProductName", SETUP_PRODUCT
            VALUE "ProductVersion", PRODUCT_VERSION_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
